# Copy this file to .env and fill in your real API keys.
# Never commit .env to version control.
#
# Which keys you need depends on which backends are in
# config/settings.yaml's rotation_order. GROQ is used by the
# text_correction stage only (Groq has no vision models); GITHUB_API_KEY
# is not needed at all since GitHub Models is being retired - see
# docs/backend_health_table.md. Run check_vision_health.py after filling
# these in to see which backends are actually alive.

GEMINI_API_KEY1=your_gemini_api_key_1_here
GEMINI_API_KEY2=your_gemini_api_key_2_here
GROQ_API_KEY1=your_groq_api_key_1_here
GROQ_API_KEY2=your_groq_api_key_2_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
SOVEREIGN_API_KEY1=your_sovereign_api_key_1_here
SOVEREIGN_API_KEY2=your_sovereign_api_key_2_here
ATRIA_API_KEY=your_atria_api_key_here
